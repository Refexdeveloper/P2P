PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=p2p_system
JWT_SECRET=change-this-secret
# Cloud Run + Cloud SQL (preferred): leave DB_HOST unset/unused and set:
# INSTANCE_CONNECTION_NAME=project:region:instance
# Also attach that Cloud SQL instance to the Cloud Run service.
CORS_ORIGIN=https://p2p-backend-645830234926.asia-south1.run.app
APP_URL=https://p2p-backend-645830234926.asia-south1.run.app
PR_NOTIFY_EMAIL=sathishkumar.r@refex.co.in
# Gmail / Google Workspace — send as support@refexone.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@refexone.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM_EMAIL=support@refexone.com
SMTP_FROM_NAME=P2P Procurement

# PO Excel import default status when not specified in request: draft | imported
PO_IMPORT_DEFAULT_STATUS=imported

# RefexOne user sync + SSO login
REFEXONE_API_URL=https://refexone.com/api
REFEXONE_WEB_URL=https://refexone.com
REFEXONE_API_TOKEN=
REFEXONE_LOGIN_ENABLED=true
# Public API / SAML ACS (must be live URL — never localhost on Cloud Run)
API_PUBLIC_URL=https://p2p-backend-645830234926.asia-south1.run.app
REFEXONE_SAML_ACS_URL=https://p2p-backend-645830234926.asia-south1.run.app/api/auth/refexone/saml/acs
REFEXONE_SAML_ENTITY_ID=https://p2p-backend-645830234926.asia-south1.run.app/auth/refexone/saml
